{
  "name": "@blackmamba/shipshell",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "concurrently -k -n api,deck -c cyan,magenta \"tsx watch server/index.ts\" \"vite\"",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "desktop:dev": "concurrently -k -n api,deck,app -c cyan,magenta,green \"tsx watch server/index.ts\" \"vite\" \"wait-on tcp:8787 http-get://127.0.0.1:5173 && electron .\"",
    "test": "vitest run",
    "doctor": "node scripts/doctor.mjs",
    "audit": "npm audit --audit-level=high",
    "check": "npm run test && npm run build",
    "validate": "npm run doctor && npm run check && npm run audit"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "openai": "^5.19.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "electron": "^43.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.4",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.4"
  }
}
